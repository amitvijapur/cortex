  .chart-grid{grid-template-columns:1fr}
  .kanban{grid-template-columns:1fr 1fr}
}
@media(max-width:560px){
  .stats{grid-template-columns:1fr}
  .kanban{grid-template-columns:1fr}
  .rc-meta{margin-left:0}
  .tagline{display:none}
}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <div class="head-in">
      <div class="brand">
        <svg class="logomark" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <rect x="0" y="0" width="7" height="7" fill="#191919"/>
          <rect x="11" y="0" width="7" height="7" fill="#191919"/>
          <rect x="0" y="11" width="7" height="7" fill="#191919"/>
          <rect x="11" y="11" width="7" height="7" fill="#191919"/>
        </svg>
        <span class="wordmark">Cortex</span>
        <span class="tagline">routing observatory</span>
      </div>
      <div class="live">
        <span class="livedot" id="livedot"></span>
        <span class="live-label">LIVE</span>
        <span id="ago">connecting…</span>
      </div>
    </div>
    <div class="tabs">
      <button class="tab active" data-act="tab" data-view="routes">Routes <span class="tc" id="tc-routes">0</span></button>
      <button class="tab" data-act="tab" data-view="analytics">Analytics</button>
      <button class="tab" data-act="tab" data-view="intake">Intake <span class="tc" id="tc-intake">0</span></button>
      <button class="tab" data-act="tab" data-view="installs">Installs <span class="tc" id="tc-installs">0</span></button>
    </div>
  </div>
</header>
<main><div class="wrap" id="main"></div></main>

<script>
"use strict";

/* ======================= state ======================= */
const state = {
  data:null, hash:null, view:"routes", lastFetch:0,
  filters:{class:null, tier:null, outcome:null, project:null},
};
const TIER_COLOR = {L1:"#059669", L2:"#191919", L3:"#5b21b6", L4:"#c0392b"};
const OUT_COLOR  = {shipped:"#059669", partial:"#9ca3af", corrected:"#d97706", abandoned:"#c0392b", pending:"#cccccc"};

/* ======================= helpers ======================= */
function esc(s){
  return String(s==null?"":s).replace(/[&<>"']/g, c=>(
    {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function ago(iso){
  if(!iso) return "";
  const t = Date.parse(iso);
  if(isNaN(t)) return "";
  let s = Math.max(0,(Date.now()-t)/1000);
  if(s<60) return Math.floor(s)+"s ago";
  const m=s/60; if(m<60) return Math.floor(m)+"m ago";
  const h=m/60; if(h<24) return Math.floor(h)+"h ago";
  const d=h/24; if(d<30) return Math.floor(d)+"d ago";
  const mo=d/30; if(mo<12) return Math.floor(mo)+"mo ago";
  return Math.floor(d/365)+"y ago";
}
function hostPath(url){
  try{ const u=new URL(url); return u.hostname.replace(/^www\./,"")+((u.pathname&&u.pathname!=="/")?u.pathname:""); }
  catch(e){ return url; }
}

/* ======================= chips / route rendering ======================= */
function agentChips(agent){
  let recon=null, left=agent;
  if(agent.indexOf("→")>=0){ const p=agent.split("→"); left=p[0]; recon=p.slice(1).join("→"); }
  const paras = left.split("∥").map(s=>s.trim()).filter(Boolean);
  let html = paras.map(p=>`<span class="chip chip-agent">${esc(p)}</span>`)
                  .join('<span class="glyph">∥</span>');
  if(recon){ html += `<span class="glyph arrow">→</span><span class="chip chip-recon">${esc(recon.trim())}</span>`; }
  return html;
}
function chipChain(r){
  const segs=[];
  if(r.system)  segs.push(`<span class="chip chip-sys">${esc(r.system)}</span>`);
  if(r.pattern) segs.push(`<span class="chip chip-pat">${esc(r.pattern)}</span>`);
  if(r.agent)   segs.push(agentChips(r.agent));
  const tier = r.tier ? String(r.tier).toUpperCase() : null;
  if(tier) segs.push(`<span class="chip tier tier-${esc(tier)}">${esc(tier)}</span>`);
  return segs.join('<span class="sep">›</span>');
}
function confDots(r){
  const dims=[["Route",r.route_confidence],["Tier",r.tier_confidence],["Spec",r.spec_confidence]];
  return '<span class="cdots">'+dims.map(([label,v])=>{
    const val=(v||r.confidence||"").toLowerCase();
    const cls = val==="high"?"c-high":val==="med"?"c-med":val==="low"?"c-low":"c-none";
    return `<span class="cdot ${cls}" title="${label} confidence: ${esc(val||"n/a")}"></span>`;
  }).join("")+"</span>";
}
function outcomeBadge(o){
  if(!o) return '<span class="ob ob-pending"><span class="pdot"></span>pending</span>';
  const map={shipped:["shipped","ob-shipped"],partial:["partial","ob-partial"],
             corrected:["corrected","ob-corrected"],abandoned:["abandoned","ob-abandoned"]};
  const m=map[o]||[o,"ob-partial"];
  return `<span class="ob ${m[1]}">${esc(m[0])}</span>`;
}
function details(r){
  const rows=[["Tier reasoning",r.tier_reason],["System reasoning",r.system_reason],
              ["Outcome note",r.outcome_note],["Redirected from",r.redirect_from],
              ["User correction",r.user_correction],["Tier audit",r.tier_audit_note]];
  let html=rows.filter(x=>x[1]).map(x=>
    `<div class="drow"><span class="dk">${x[0]}</span><span class="dv">${esc(x[1])}</span></div>`).join("");
  html+=`<div class="dmeta"><span class="mono">session ${esc(r.session_id||"—")}</span>`
      + `<span class="mono">#${esc(r.task_hash||"—")}</span></div>`;
  return html;
}
function routeCard(r, idx){
  return `<div class="route-card" data-act="toggle">
    <span class="rc-num">${(idx||0)+1}</span>
    <div class="rc-head">
      <div class="chipline">${chipChain(r)}</div>
      <div class="rc-meta">${confDots(r)}${outcomeBadge(r.outcome)}<span class="rc-time">${ago(r.ts)}</span></div>
    </div>
    <div class="rc-task">${esc(r.task||"—")}</div>
    <div class="rc-tags">
      <span class="badge b-proj">${esc(r.project||"—")}</span>
      <span class="badge b-class">${esc(r.class||"—")}</span>
    </div>
    <div class="rc-details">${details(r)}</div>
    <span class="chev">▾</span>
  </div>`;
}

/* ======================= routes view ======================= */
function passFilter(r,f){
  if(f.class && r.class!==f.class) return false;
  if(f.tier && String(r.tier).toUpperCase()!==f.tier) return false;
  if(f.outcome){ if((r.outcome||"pending")!==f.outcome) return false; }
  if(f.project && r.project!==f.project) return false;
  return true;
}
function computeStats(R){
  const st={total:R.length, shipped:0, resolved:0, corrections:0, tiers:{L1:0,L2:0,L3:0,L4:0}};
  R.forEach(r=>{
    const o=r.outcome;
    if(o){ st.resolved++; if(o==="shipped") st.shipped++; }
    if(o==="corrected" || r.redirect_from || r.user_correction) st.corrections++;
    const t=String(r.tier||"").toUpperCase();
    if(st.tiers[t]!==undefined) st.tiers[t]++;
  });
  return st;
}
function statStrip(st){
  const pct = st.resolved ? Math.round(st.shipped/st.resolved*100) : 0;
  const maxTier = Math.max(1, st.tiers.L1, st.tiers.L2, st.tiers.L3, st.tiers.L4);
  const bars = ["L1","L2","L3","L4"].map(t=>{
    const w=Math.round(st.tiers[t]/maxTier*100);
    return `<div class="tierbar"><span class="lab">${t}</span>
      <span class="track"><span class="fill" style="width:${w}%;background:${TIER_COLOR[t]}"></span></span>
      <span class="cnt">${st.tiers[t]}</span></div>`;
  }).join("");
  return `<div class="stats">
    <div class="stat"><div class="k">Total routes</div><div class="v">${st.total}</div>
      <div class="sub">logged decisions</div></div>
    <div class="stat s-ship"><div class="k">Shipped</div><div class="v">${pct}<small>%</small></div>
      <div class="sub">${st.shipped} of ${st.resolved} resolved</div></div>
    <div class="stat s-corr"><div class="k">Corrections</div><div class="v${st.corrections>0?" v-red":""}">${st.corrections}</div>
      <div class="sub">reroutes &amp; corrected</div></div>
    <div class="stat s-tier"><div class="k">Tier mix</div><div class="tierbars">${bars}</div></div>
  </div>`;
}
function pill(group,val,label){
  const on = state.filters[group]===val ? " on" : "";
  return `<button class="pill${on}" data-act="filter" data-group="${esc(group)}" data-val="${esc(val)}">${esc(label)}</button>`;
}
function filterBar(R){
  const classes=[...new Set(R.map(r=>r.class).filter(Boolean))].sort();
  const projects=[...new Set(R.map(r=>r.project).filter(Boolean))].sort();
  const outcomes=["shipped","partial","corrected","abandoned","pending"];
  const g=(label,html)=>`<div class="fgroup"><span class="glabel">${label}</span>${html}</div>`;
  return `<div class="filters">
    ${g("Class", classes.map(c=>pill("class",c,c)).join(""))}
    ${g("Tier", ["L1","L2","L3","L4"].map(t=>pill("tier",t,t)).join(""))}
    ${g("Outcome", outcomes.map(o=>pill("outcome",o,o)).join(""))}
    ${g("Project", projects.map(p=>pill("project",p,p)).join(""))}
  </div>`;
}
function renderRoutes(){
  const R=state.data.routes;
  if(!R.length) return statStrip(computeStats(R)) +
    emptyState("No routes logged yet","Cortex writes a line here every time it routes a task. Run something through the protocol and it will appear.");
  const filtered=R.filter(r=>passFilter(r,state.filters));
  const feed = filtered.length
    ? `<div class="feed">${filtered.map(routeCard).join("")}</div>`
    : emptyState("No routes match these filters","Clear a filter pill to widen the view.");
  return statStrip(computeStats(R)) + filterBar(R) + feed;
}

/* ======================= analytics view ======================= */
function countMap(R, keyfn){
  const m=new Map();
  R.forEach(r=>{ const k=keyfn(r); if(k==null||k==="") return; m.set(k,(m.get(k)||0)+1); });
  return m;
}
function mapToSorted(m){ return [...m.entries()].map(([label,value])=>({label,value})).sort((a,b)=>b.value-a.value); }

function svgHBars(items, accent){
  if(!items.length) return "";
  const max=Math.max(1,...items.map(i=>i.value));
  const rowH=30, pad=6, labelW=118, barX=labelW+12, barMaxW=600-barX-46;
  const W=600, H=items.length*rowH+pad*2;
  let rows="";
  items.forEach((it,idx)=>{
    const y=pad+idx*rowH, cy=y+rowH/2;
    const bw=Math.max(2,(it.value/max)*barMaxW);
    const color=it.color||accent;
    rows+=`<text x="${labelW}" y="${cy}" class="c-label" text-anchor="end" dominant-baseline="middle">${esc(it.label)}</text>`
        + `<rect x="${barX}" y="${y+7}" width="${bw}" height="${rowH-15}" rx="4" fill="${color}" opacity="0.92"></rect>`
        + `<text x="${barX+bw+8}" y="${cy}" class="c-val" dominant-baseline="middle">${it.value}</text>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" class="chart" preserveAspectRatio="xMinYMin meet" role="img">${rows}</svg>`;
}
function svgVBars(items, accent){
  if(!items.length) return "";
  const max=Math.max(1,...items.map(i=>i.value));
  const W=600,H=210, padL=30, padB=30, padT=10, padR=8;
  const plotW=W-padL-padR, plotH=H-padB-padT, n=items.length, step=plotW/n;
  const bw=Math.max(4, step*0.6);
  let grid="", gl=4;
  for(let i=0;i<=gl;i++){
    const gy=padT+plotH*(i/gl), v=Math.round(max*(1-i/gl));
    grid+=`<line x1="${padL}" y1="${gy}" x2="${W-padR}" y2="${gy}" class="c-grid"/>`
        + `<text x="${padL-6}" y="${gy}" class="c-axis" text-anchor="end" dominant-baseline="middle">${v}</text>`;
  }
  let bars="", every=Math.max(1,Math.ceil(n/9));
  items.forEach((it,idx)=>{
    const x=padL+idx*step+(step-bw)/2;
    const bh=(it.value/max)*plotH, y=padT+plotH-bh;
    bars+=`<rect x="${x}" y="${y}" width="${bw}" height="${Math.max(0,bh)}" rx="3" fill="${accent}" opacity="0.92"><title>${esc(it.label)}: ${it.value}</title></rect>`;
    if(idx%every===0 || idx===n-1){
      bars+=`<text x="${x+bw/2}" y="${H-padB+15}" class="c-axis" text-anchor="middle">${esc(it.label)}</text>`;
    }
  });
  return `<svg viewBox="0 0 ${W} ${H}" class="chart" role="img">${grid}${bars}</svg>`;
}
function svgMeter(segs){
  const total=segs.reduce((a,s)=>a+s.value,0)||1;
  const W=600,H=42; let x=0, rects="";
  segs.forEach(s=>{ if(s.value<=0) return; const w=(s.value/total)*W;
    rects+=`<rect x="${x}" y="0" width="${Math.max(0,w-1.5)}" height="${H}" fill="${s.color}"><title>${esc(s.label)}: ${s.value}</title></rect>`;
    x+=w; });
  const svg=`<svg viewBox="0 0 ${W} ${H}" class="chart" preserveAspectRatio="none" role="img" style="border-radius:8px;overflow:hidden">${rects}</svg>`;
  const legend='<div class="legend">'+segs.filter(s=>s.value>0).map(s=>
    `<span class="li"><span class="sw" style="background:${s.color}"></span>${esc(s.label)} <b>${s.value}</b></span>`).join("")+"</div>";
  return svg+legend;
}
function weekBuckets(R){
  const dayMs=86400000;
  function monday(d){ const x=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate()));
    const dow=(x.getUTCDay()+6)%7; x.setUTCDate(x.getUTCDate()-dow); return x.getTime(); }
  const counts=new Map(); let lo=Infinity, hi=-Infinity;
  R.forEach(r=>{ const t=Date.parse(r.ts); if(isNaN(t)) return;
    const m=monday(new Date(t)); counts.set(m,(counts.get(m)||0)+1); if(m<lo)lo=m; if(m>hi)hi=m; });
  if(!isFinite(lo)) return [];
  const MON=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const out=[];
  for(let m=lo;m<=hi;m+=7*dayMs){ const d=new Date(m);
    out.push({label:MON[d.getUTCMonth()]+" "+d.getUTCDate(), value:counts.get(m)||0}); }
  return out;
}
function lowConfCounts(R){
  const c={Route:0,Tier:0,Spec:0};
  R.forEach(r=>{
    if((r.route_confidence||r.confidence||"").toLowerCase()==="low") c.Route++;
    if((r.tier_confidence ||r.confidence||"").toLowerCase()==="low") c.Tier++;
    if((r.spec_confidence ||r.confidence||"").toLowerCase()==="low") c.Spec++;
  });
  return c;
}
function chartPanel(title, sub, inner){
  return `<section class="panel"><div class="panel-h"><h2>${esc(title)}</h2><span class="panel-sub">${esc(sub)}</span></div>${inner}</section>`;
}
function renderAnalytics(){
  const R=state.data.routes;
  if(!R.length) return emptyState("Nothing to chart yet","Analytics populate from routing decisions as they accumulate.");

  const tiers=["L1","L2","L3","L4"].map(t=>({label:t, value:R.filter(r=>String(r.tier).toUpperCase()===t).length, color:TIER_COLOR[t]}));
  const classes=mapToSorted(countMap(R,r=>r.class));
  const systems=mapToSorted(countMap(R,r=>r.system));
  const weeks=weekBuckets(R);

  const outOrder=["shipped","partial","corrected","abandoned","pending"];
  const outCounts={}; outOrder.forEach(o=>outCounts[o]=0);
  R.forEach(r=>{ const o=r.outcome||"pending"; if(outCounts[o]===undefined) outCounts[o]=0; outCounts[o]++; });
  const outSegs=outOrder.filter(o=>outCounts[o]>0).map(o=>({label:o, value:outCounts[o], color:OUT_COLOR[o]}));

  const low=lowConfCounts(R);
  const lowItems=[
    {label:"Route", value:low.Route, color:"#c0392b"},
    {label:"Tier",  value:low.Tier,  color:"#d97706"},
    {label:"Spec",  value:low.Spec,  color:"#c0392b"},
  ];

  return `<div class="chart-grid">
    ${chartPanel("Routes over time","per week", svgVBars(weeks,"#5b21b6"))}
    ${chartPanel("Tier distribution","L1–L4", svgHBars(tiers))}
    ${chartPanel("Class breakdown","by task type", svgHBars(classes,"#191919"))}
    ${chartPanel("System usage","routed to", svgHBars(systems,"#5b21b6"))}
    ${chartPanel("Outcome split","resolved vs pending", svgMeter(outSegs))}
    ${chartPanel("Low-confidence flags","per dimension", svgHBars(lowItems))}
  </div>`;
}

/* ======================= intake view ======================= */
const RECMAP={add:["add","rec-add"], skip:["skip","rec-skip"], trial:["trial","rec-trial"], maybe:["maybe","rec-maybe"]};
function recChip(rec){
  const m=RECMAP[rec]||[rec||"—","rec-none"];
  return `<span class="rec ${m[1]}">${esc(m[0])}</span>`;
}
function intakeCard(it){
  const summary=it.summary ? `<div class="ic-summary">${esc(it.summary)}</div>` : "";
  const link=it.url ? `<a class="ic-link" href="${esc(it.url)}" target="_blank" rel="noopener">${esc(hostPath(it.url))} ↗</a>` : "";
  const kind=it.kind ? `<div class="ic-kind">${esc(it.kind)}</div>` : "";
  return `<div class="intake-card" data-act="toggle">
    <div class="ic-head">${recChip(it.recommendation)}<span class="ic-time">${ago(it.ts)}</span></div>
    <div class="ic-title">${esc(it.title)}</div>
    ${kind}
    <div class="ic-body">${summary}${link}</div>
  </div>`;
}
function renderIntake(){
  const I=state.data.inbox;
  if(!I.length) return emptyState("Intake pipeline is empty","Drop a link into @cortexbuildbot and reviewed candidates will flow through these columns.");
  const COLS=[
    {t:"In flight", statuses:["pending","reviewing"]},
    {t:"Reviewed / Building", statuses:["reviewed","building"]},
    {t:"Integrated", statuses:["integrated"]},
    {t:"Rejected / Failed", statuses:["rejected","failed"]},
    {t:"Answered", statuses:["answered"]},
  ];
  const cols=COLS.map(col=>{
    const items=I.filter(x=>col.statuses.includes(x.status));
    const body = items.length ? items.map(intakeCard).join("")
      : `<div class="empty-s" style="padding:10px 2px">nothing here</div>`;
    return `<div class="kcol"><div class="kcol-h"><span class="t">${esc(col.t)}</span><span class="n">${items.length}</span></div>
      <div class="kcards">${body}</div></div>`;
  }).join("");
  return `<div class="kanban">${cols}</div>`;
}

/* ======================= installs view ======================= */
function installCard(it){
  const note=it.note ? `<div class="inst-note">${esc(it.note)}</div>` : "";
  const cmds=esc((it.commands||[]).join("\n"));
  const when = it.status==="done" ? ago(it.done_ts||it.ts) : ago(it.ts);
  return `<div class="install-card">
    <div class="inst-head">
      <span class="inst-label">${esc(it.label)}</span>
      <span class="badge status-${esc(it.status)}">${esc(it.status)}</span>
      <span class="inst-time">${when}</span>
    </div>
    ${note}
    <pre class="codeblock">${cmds}</pre>
  </div>`;
}
function renderInstalls(){
  const N=state.data.installs;
  if(!N.length) return emptyState("No queued installs","Setup commands surfaced by intake builds land here until you run them.");
  const pending=N.filter(i=>i.status!=="done");
  const done=N.filter(i=>i.status==="done");
  const group=(title,arr)=> arr.length ? `<section class="panel">
      <div class="panel-h"><h2>${title}</h2><span class="panel-sub">${arr.length}</span></div>
      ${arr.map(installCard).join("")}</section>` : "";
  const pendingBlock = pending.length ? group("Pending",pending)
    : `<section class="panel"><div class="panel-h"><h2>Pending</h2><span class="panel-sub">0</span></div>
       ${emptyState("Queue is clear","Every surfaced install has been run. Nice.")}</section>`;
  return `<div class="inst-groups">${pendingBlock}${group("Done",done)}</div>`;
}

/* ======================= shell ======================= */
function emptyState(title,sub){
  const mark=`<svg class="empty-mark" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">`
    + `<rect x="0.5" y="0.5" width="25" height="25" fill="none" stroke="#191919" stroke-width="1"/>`
    + `<rect x="6" y="6" width="6" height="6" fill="#191919"/><rect x="14" y="6" width="6" height="6" fill="#191919"/>`
    + `<rect x="6" y="14" width="6" height="6" fill="#191919"/><rect x="14" y="14" width="6" height="6" fill="#191919"/></svg>`;
  return `<div class="panel"><div class="empty">${mark}`
    + `<div class="empty-t">${esc(title)}</div><div class="empty-s">${esc(sub||"")}</div></div></div>`;
}
function updateTabs(){
  document.querySelectorAll(".tab").forEach(t=>t.classList.toggle("active", t.dataset.view===state.view));
  if(state.data){
    const c=state.data.meta.counts;
    const set=(id,n)=>{ const el=document.getElementById(id); if(el) el.textContent=n; };
    set("tc-routes",c.routes); set("tc-intake",c.inbox); set("tc-installs",c.installs);
  }
}
function render(){
  updateTabs();
  const main=document.getElementById("main");
  if(!state.data){ main.innerHTML=emptyState("Connecting to Cortex…","Reading the routing log."); return; }
  const v=state.view;
  main.innerHTML = v==="analytics" ? renderAnalytics()
                 : v==="intake"    ? renderIntake()
                 : v==="installs"  ? renderInstalls()
                 : renderRoutes();
}

/* ======================= events ======================= */
document.addEventListener("click", e=>{
  const a=e.target.closest("[data-act]");
  if(!a) return;
  const act=a.dataset.act;
  if(act==="tab"){ if(state.view!==a.dataset.view){ state.view=a.dataset.view; render(); } }
  else if(act==="filter"){
    const g=a.dataset.group, v=a.dataset.val;
    state.filters[g] = state.filters[g]===v ? null : v;
    render();
  }
  else if(act==="toggle"){
    if(e.target.closest("a")) return;
    a.classList.toggle("open");
  }
});

/* ======================= live loop ======================= */
async function poll(){
  try{
    const res=await fetch("/api/data",{cache:"no-store"});
    const json=await res.json();
    state.lastFetch=Date.now();
    const d=document.getElementById("livedot"); if(d) d.classList.remove("down","stale");
    if(json.meta && json.meta.hash!==state.hash){
      state.hash=json.meta.hash; state.data=json; render();
    } else { updateTabs(); }
  }catch(err){
    const d=document.getElementById("livedot"); if(d) d.classList.add("down");
  }
}
function tickAgo(){
  const el=document.getElementById("ago"); if(!el) return;
  if(!state.lastFetch){ el.textContent="connecting…"; return; }
  const s=Math.floor((Date.now()-state.lastFetch)/1000);
  el.textContent="updated "+s+"s ago";
  const dot=document.getElementById("livedot");
  if(dot && !dot.classList.contains("down")) dot.classList.toggle("stale", s>12);
}

render();
poll();
setInterval(poll, 4000);
setInterval(tickAgo, 1000);
</script>
</body>
</html>'''


# --------------------------------------------------------------------------- #
# HTTP server
# --------------------------------------------------------------------------- #
class Handler(BaseHTTPRequestHandler):
    server_version = "cortex-ui/1.0"

    def _send(self, code, body, ctype):
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/":
            self._send(200, HTML_PAGE, "text/html; charset=utf-8")
        elif path == "/api/data":
            try:
                payload = build_payload()
                body = json.dumps(payload, default=str)
                self._send(200, body, "application/json; charset=utf-8")
            except Exception as exc:  # never crash the server on a bad read
                self._send(500, json.dumps({"error": str(exc)}), "application/json")
        elif path == "/favicon.ico":
            self._send(204, b"", "image/x-icon")
        else:
            self._send(404, "not found", "text/plain")

    def log_message(self, *args):  # keep stdout clean (only the URL is printed)
        pass


def serve(start_port, open_browser):
    httpd = None
    port = None
    last_err = None
    for p in range(start_port, start_port + 11):
        try:
            httpd = ThreadingHTTPServer(("127.0.0.1", p), Handler)
            port = p
            break
        except OSError as exc:
            last_err = exc
            continue
    if httpd is None:
        raise SystemExit(
            f"cortex-ui: could not bind a port in range "
            f"{start_port}-{start_port + 10} ({last_err})"
        )

    url = f"http://127.0.0.1:{port}/"
    print(f"cortex-ui live at {url}")
    print("  reading (read-only):")
    for label, path in (("log", LOG_PATH), ("inbox", INBOX_PATH), ("installs", INSTALLS_PATH)):
        mark = "ok" if path.exists() else "missing (empty state)"
        print(f"    {label:9s} {path}  [{mark}]")
    print("  Ctrl-C to stop.")

    if open_browser:
        try:
            webbrowser.open(url)
        except Exception:
            pass

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\ncortex-ui stopped.")
    finally:
        httpd.server_close()


def main():
    ap = argparse.ArgumentParser(
        prog="cortex-ui",
        description="Local live dashboard for the Cortex routing layer (read-only).",
    )
    ap.add_argument("--port", type=int, default=7777,
                    help="preferred port (falls through the next 10 if busy). Default 7777.")
    ap.add_argument("--no-open", action="store_true",
                    help="do not auto-open the browser.")
    args = ap.parse_args()
    serve(args.port, not args.no_open)


if __name__ == "__main__":
    main()
