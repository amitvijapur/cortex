#!/usr/bin/env python3
"""cortex-ui — local live mission-control dashboard for Cortex, Amit's Claude Code
workflow-routing layer.

Serves a self-contained, dependency-free web dashboard that reads (never writes)
three JSONL files:

  ~/.claude/cortex-log.jsonl          routing decisions
  ~/.claude/cortex-inbox.jsonl        Telegram intake pipeline
  ~/.claude/cortex-install-queue.jsonl pending / done installs

Python 3 stdlib only. Binds 127.0.0.1. Read-only over the data files.

Usage:
    cortex-ui [--port 7777] [--no-open]
"""

import argparse
import hashlib
import json
import webbrowser
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

# --------------------------------------------------------------------------- #
# Data sources (read-only)
# --------------------------------------------------------------------------- #
HOME = Path.home()
LOG_PATH = HOME / ".claude" / "cortex-log.jsonl"
INBOX_PATH = HOME / ".claude" / "cortex-inbox.jsonl"
INSTALLS_PATH = HOME / ".claude" / "cortex-install-queue.jsonl"


def load_jsonl(path):
    """Parse a JSONL file defensively.

    Returns (records, malformed_count, mtime_iso). Missing file -> ([], 0, None).
    Skips blank lines and any line that isn't a JSON object.
    """
    records = []
    malformed = 0
    mtime = None
    try:
        st = path.stat()
        mtime = datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat()
        text = path.read_text(encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return [], 0, None
    except OSError:
        return [], 0, None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            malformed += 1
            continue
        if isinstance(obj, dict):
            records.append(obj)
        else:
            malformed += 1
    return records, malformed, mtime


def parse_ts(value):
    """Parse an ISO-ish timestamp string into a datetime, or None."""
    if not isinstance(value, str):
        return None
    s = value.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        return datetime.fromisoformat(s)
    except ValueError:
        return None


def route_sort_key(r):
    """Newest-first sort key (used with reverse=True). Undated rows sink last."""
    dt = parse_ts(r.get("ts"))
    if dt is None:
        return (0, 0.0)
    return (1, dt.timestamp())


def short_url(url):
    """Reduce a URL to host+path for a compact card title."""
    if not url:
        return ""
    try:
        p = urlparse(url)
        host = (p.netloc or "").replace("www.", "")
        path = p.path if p.path and p.path != "/" else ""
        return (host + path) or url
    except ValueError:
        return url


def norm_inbox(r):
    """Normalise a messy inbox row into a stable shape for the frontend.

    Handles verdict as: dict, plain string ("skip: ..."), error dict, or null;
    and verdict.summary as either a string or a list of strings; plus the
    'answered' rows which carry an `answer` dict instead of a verdict.
    """
    url = r.get("url") or ""
    verdict = r.get("verdict")
    rec = title = kind = summary = slots = None

    if isinstance(verdict, dict):
        if verdict.get("error"):
            summary = "Error: " + str(verdict.get("error"))
        else:
            rec = verdict.get("recommendation")
            title = verdict.get("title")
            kind = verdict.get("kind")
            slots = verdict.get("slots_into")
            s = verdict.get("summary")
            if isinstance(s, list):
                summary = "\n".join(str(x) for x in s)
            elif isinstance(s, str):
                summary = s
    elif isinstance(verdict, str):
        summary = verdict
        head = verdict.split(":", 1)[0].strip().lower()
        if head in ("skip", "add", "maybe", "trial"):
            rec = head

    # 'answered' freeform rows keep their reply under `answer`.
    ans = r.get("answer")
    if summary is None and isinstance(ans, dict):
        summary = ans.get("answer")
        kind = kind or "freeform answer"

    if isinstance(rec, str):
        rec = rec.strip().lower()

    if not title:
        note = str(r.get("note") or "").strip()
        title = short_url(url) if url else (note[:70] or "Freeform message")

    return {
        "id": r.get("id"),
        "ts": r.get("ts"),
        "url": url,
        "status": (r.get("status") or "").lower(),
        "note": r.get("note") or "",
        "recommendation": rec,
        "title": title,
        "kind": kind or "",
        "summary": summary or "",
        "slots_into": slots or "",
    }


def norm_install(r):
    """Normalise an install-queue row. `status` is pending|done."""
    cmds = r.get("commands")
    if not isinstance(cmds, list):
        cmds = [str(cmds)] if cmds else []
    return {
        "id": r.get("id"),
        "ts": r.get("ts"),
        "source_id": r.get("source_id"),
        "label": r.get("label") or "(unlabelled)",
        "note": r.get("note") or "",
        "commands": [str(c) for c in cmds],
        "status": (r.get("status") or "pending").lower(),
        "done_ts": r.get("done_ts"),
    }


def build_payload():
    """Read all three files fresh (so the API is live) and assemble the payload."""
    routes_raw, r_bad, r_mtime = load_jsonl(LOG_PATH)
    inbox_raw, i_bad, i_mtime = load_jsonl(INBOX_PATH)
    inst_raw, n_bad, n_mtime = load_jsonl(INSTALLS_PATH)

    routes = sorted(routes_raw, key=route_sort_key, reverse=True)
    inbox = [norm_inbox(x) for x in inbox_raw]
    installs = [norm_install(x) for x in inst_raw]

    data = {"routes": routes, "inbox": inbox, "installs": installs}
    # Content hash (excludes generated_at) so the frontend only re-renders on change.
    h = hashlib.md5(
        json.dumps(data, sort_keys=True, default=str).encode("utf-8")
    ).hexdigest()

    now = datetime.now(timezone.utc)
    meta = {
        "generated_at": now.isoformat(),
        "hash": h,
        "file_mtimes": {"log": r_mtime, "inbox": i_mtime, "installs": n_mtime},
        "counts": {
            "routes": len(routes),
            "inbox": len(inbox),
            "installs": len(installs),
            "malformed": {"log": r_bad, "inbox": i_bad, "installs": n_bad},
        },
    }
    return {**data, "meta": meta}


